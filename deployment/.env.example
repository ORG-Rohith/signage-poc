# Deployment Configuration

# Node Environment
NODE_ENV=production

# Database Configuration
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=signage_db

# Full PostgreSQL Connection URL (used by Backend)
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Frontend API Configuration
# Use internal docker network URL or external API endpoint
# NEXT_PUBLIC_API_URL=https://signage-backend:3001
NEXT_PUBLIC_API_URL=/api
LOG_LEVEL=info
# For external API (e.g., ngrok):
# NEXT_PUBLIC_API_URL=https://instructively-liturgistic-madie.ngrok-free.dev

# Docker Images (use local images or registry URLs)
# Examples:
#   - Local: signage-backend:latest
#   - Registry: myregistry.azurecr.io/signage-backend:v1.0.0
BACKEND_IMAGE=signage-backend:latest
FRONTEND_IMAGE=signage-frontend:latest
